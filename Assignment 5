B2. Adversarial Data
import csv
def inspect_csv(path):
    try:
        with open(path, "r", encoding="utf-8", newline="") as f:
            sample = f.read(2048)
            if not sample.strip(): return "ERROR: empty file"
            f.seek(0)
            reader = csv.DictReader(f)
            required = {"station","date","pm25"}
            missing = required - set(reader.fieldnames or [])
            if missing: return "ERROR: missing columns: " + ", ".join(sorted(missing))
            return "OK: columns found"
    except UnicodeDecodeError:
        return "ERROR: unsupported encoding; use documented source encoding"
    except OSError as exc:
        return "ERROR: " + str(exc)
# Wrong delimiter often creates one combined header; required-column check catches it.
A missing column is reported before processing. A semicolon file read as comma-separated usually has one combined header and is
reported as missing columns. Non-UTF-8 data raises UnicodeDecodeError; reopen using its documented encoding (for example
cp1252). An empty file is reported explicitly.
