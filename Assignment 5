def z_score(values):
    if not values: return []
    mean = sum(values) / len(values)
    variance = sum((x-mean)**2 for x in values) / len(values)
    sd = variance ** 0.5
    return [0.0 if sd == 0 else (x-mean)/sd for x in values]
