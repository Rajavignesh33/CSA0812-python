B1. Cleaning Pipeline
import csv, io
RAW = "station,date,pm25\\nAdyar,2026-10-01,48\\nAdyar,2026-10-02,NA\\nAdyar,2026-10-03,\\nGuindy,2026-10-01,95\\nGuindy,2026-10-02,-5\\nGuindy,2026-10-03,121\\nAdyar,2026-10-04,1200\\n"
def load_clean(text):
    rows = []
    for row in csv.DictReader(io.StringIO(text)):
        value = (row.get("pm25") or "").strip()
        if value.upper() in ("", "NA"):
            continue
        try:
            pm = float(value)
        except ValueError:
            continue
        if pm < 0 or pm > 999:
            continue
        rows.append((row["station"].strip(), row["date"], pm))
    return rows
def min_max(values):
    if not values: return []
    lo, hi = min(values), max(values)
    if hi == lo: return [0.0 for _ in values]
    return [round((v-lo)/(hi-lo), 3) for v in values]
clean = load_clean(RAW)
print(clean)
print(min_max([pm for _, _, pm in clean]))
